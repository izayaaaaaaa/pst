# Copy to .env and edit. All values are optional.

# Port Chrome listens on for the script. Chrome only binds it to localhost.
CDP_PORT=9222

# Dedicated Chrome profile for this account.
# Default (outside the repo so it never gets committed):
#   Windows: %LOCALAPPDATA%\pst\chrome-profile
#   macOS:   ~/Library/Application Support/pst/chrome-profile
#   Linux:   ~/.local/share/pst/chrome-profile
# CHROME_PROFILE_DIR=

# Path to the Chrome binary if it's not in the usual place
# (chrome.exe on Windows, .../Google Chrome.app/Contents/MacOS/Google Chrome on macOS).
# CHROME_PATH=

# Safety limits per run.
MAX_PAGE_VISITS=15
MIN_DELAY_MS=2500
MAX_DELAY_MS=7000

# Refuse to run between these hours (local time, 24h). Set both to the same value to disable.
QUIET_START_HOUR=1
QUIET_END_HOUR=7

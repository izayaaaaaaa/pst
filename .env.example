# Copy to .env and edit. All values are optional.

# Port Chrome listens on for the script. Chrome only binds it to localhost.
CDP_PORT=9222

# Dedicated Chrome profile for this account.
# Default (outside the repo so it never gets committed):
#   Windows: %LOCALAPPDATA%\pst\chrome-profile
#   macOS:   ~/Library/Application Support/pst/chrome-profile
#   Linux:   ~/.local/share/pst/chrome-profile
# CHROME_PROFILE_DIR=

# Path to the Chrome binary if it's not in the usual place
# (chrome.exe on Windows, .../Google Chrome.app/Contents/MacOS/Google Chrome on macOS).
# CHROME_PATH=

# Safety limits per run.
MAX_PAGE_VISITS=15
# Visits allowed per local day across all watches and market runs (counted in output/).
MAX_DAILY_VISITS=60
MIN_DELAY_MS=2500
MAX_DELAY_MS=7000

# Refuse to run between these hours (local time, 24h). Set both to the same value to disable.
QUIET_START_HOUR=1
QUIET_END_HOUR=7

# Local UI (npm run ui) port. Listens on 127.0.0.1 only.
UI_PORT=5173

# Marketplace location slug or id for searches. Empty uses your profile's location.
# MARKET_LOCATION=

# Search radius in km for Marketplace searches.
MARKET_RADIUS_KM=6

# Currency for prices when Facebook doesn't show a symbol.
MARKET_CURRENCY=PHP

# Where watches and visit counts are stored. Default: output/ in the repo.
# OUTPUT_DIR=
